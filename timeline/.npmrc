# npm 10 crashes resolving the optional peer cycle vite -> @vitejs/devtools -> vitest@*;
# every required peer is listed explicitly in the workspace manifests instead.
legacy-peer-deps=true
# No dependency needs an install script: better-sqlite3 ships prebuilt binaries for
# win32/linux/darwin, but `npm ci` would still attempt an implicit node-gyp rebuild.
# Explicit `npm test` / `npm run <script>` are unaffected.
ignore-scripts=true
save-exact=true
engine-strict=true
